# 모든 변수에 기본값이 있어 tfvars 없이도 실행 가능
# 값을 바꾸고 싶을 때만 terraform.tfvars로 복사해서 수정

aws_region   = "ap-northeast-2"
project_name = "accordion"

# ===== Worker EC2 (기존 Worker와 동일) =====
ubuntu_ami_id        = "ami-0e1eeb87102d64f40"
worker_instance_type = "t3.medium"
k8s_version          = "1.36.5"

# ===== Worker Auto Scaling (AZ 2d) =====
asg_min_size      = 0
asg_max_size      = 1
asg_scale_out_cpu = 60
asg_scale_in_cpu  = 30
